##########################################################################
#
# Rules for the code generated from the headers: project7, the glue and the
# dictionary make rules. Included by make_targets.inc.
#
##########################################################################

# Glasses: <Glass>.h -> <Glass>.h7, <Glass>.c7, Views/<Glass>View.{h,cxx}.
# All glasses of a libset live in its single BLESSED_DIRS directory.

GLASS_DIR := ${BLESSED_DIRS}
ifneq ($(words ${GLASS_DIR}),1)
  $(error BLESSED_DIRS must name exactly one directory, got '${GLASS_DIR}')
endif

${GLASS_DIR}/%.h7 ${GLASS_DIR}/%.c7: ${GLASS_DIR}/%.h
	${ECHO} -7- Project7 blessed base $<
	${MUTE} ${P7} -c $* -i $< -1 ${GLASS_DIR}/$*.h7 -3 ${GLASS_DIR}/$*.c7

${VIEW_DIR}/%View.h ${VIEW_DIR}/%View.cxx: ${GLASS_DIR}/%.h
	${ECHO} -7- Project7 blessed view $<
	${MUTE} mkdir -p ${VIEW_DIR}
	${MUTE} ${P7} -c $* -i $< -5 ${VIEW_DIR}/$*View.h -7 ${VIEW_DIR}/$*View.cxx

${BLESSED_OBJS}: %.o: %.h7 %.c7

# Other classes: a header that includes its own "<Class>.h7" gets the
# accessors generated by project7.

P7_AUTO_HDRS := $(patsubst %.h,%.h7,$(shell grep -lE '^\s*[#]include\s+"\w+\.h7"' ${ALL_HDRS} /dev/null 2>/dev/null))
.SECONDARY: ${P7_AUTO_HDRS}

${P7_AUTO_HDRS}: %.h7: %.h
	${ECHO} -7- Project7 $<
	${MUTE} ${P7} -c $(notdir $*) -i $< -1 $@

$(P7_AUTO_HDRS:.h7=.o): %.o: %.h7

# Glue: registration of the libset, its glasses, views and renderers, from
# glass.list, REQUIRES_LIB_SETS in the Makefile and RENDERERS.

GLUE_FILES := $(foreach x,LibSet View_LibSet $(patsubst %,Rnr_%_LibSet,${RENDERERS}), \
                ${GLUE_DIR}/${LIB_SET_NAME}_${x}.h ${GLUE_DIR}/${LIB_SET_NAME}_${x}.cxx)

${GLUE_FILES} &: glass.list Makefile ${GLEDSYS}/make/make_rnr.inc
	${ECHO} -G- Generating glass glue
	${MUTE} mkdir -p ${GLUE_DIR}
	${MUTE} ${GLEDGLUEGEN} ${REQUIRES_LIB_SETS} :: ${RENDERERS}

# Manifest: the libset's name, ID, required libsets and glasses, for builds
# of other libsets against this one. Same inputs as the glue.

MANIFEST := lib/${LIB_SET_NAME}.manifest

${MANIFEST}: glass.list Makefile ${BUILD_CONFIG} ${GLEDMANIFEST}
	${ECHO} -M- Writing libset manifest
	${MUTE} mkdir -p lib
	${MUTE} ${GLEDMANIFEST} ${REQUIRES_LIB_SETS} > $@.tmp && mv $@.tmp $@

# Dictionaries: make_dict.inc is written by gled_mk_dict_dep.pl and is
# rewritten whenever the glass list, a LinkDef file or the Makefile changes.

# rootcling reads the .h7 files. On a first build the dependency files that
# name them do not exist yet, so the .h7 files are made first.

ifneq (${DICT_AUTO_SRCS},)
${DICT_AUTO_SRCS}: | ${BLESSED_H7} ${P7_AUTO_HDRS}
endif

# Not under QUIET_GOALS, see make_base.inc.

ifeq (${QUIET_GOALS},)
make_dict.inc: glass.list ${LINKDEF_HDRS} Makefile
	${ECHO} -d- Generating ROOT dictionary dependencies
	${MUTE} mkdir -p ${DICT_DIR}
	${MUTE} ${MKDICTDEP} ${LIB_SET_NAME} ${DICT_HDRS} > $@.tmp && mv $@.tmp $@
endif
