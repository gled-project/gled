#!/usr/bin/perl

# Copyright (C) Matevz Tadel.
# This file is part of Gled.
# SPDX-License-Identifier: LGPL-3.0-or-later

# Creates a new libset, or a new glass, stone or GL renderer in a libset.
# See usage() below.

use strict;
use warnings;
use Getopt::Long qw(GetOptionsFromArray);
use Cwd qw(getcwd);
use File::Basename qw(basename);

die "GLEDSYS not defined\n" unless exists $ENV{GLEDSYS};
my $GLEDSYS = $ENV{GLEDSYS};
my $SKELDIR = "$GLEDSYS/cfg";

sub usage
{
  print STDERR <<"FNORD";
usage:
  gled-create libset <LibSet> <lib-set-id> [--requires '<LibSet> ...']
      Creates <LibSet> in the first libsetpath directory of the build,
      ../libsets by default.
      --requires defaults to GledCore.

  Run the following in the top directory of a libset:

  gled-create glass <Class> [--base <Glass>] [--id <class-id>]
      Writes Glasses/<Class>.{h,cxx} and adds the glass to glass.list.
      --base defaults to ZGlass; --id defaults to the largest id + 1.

  gled-create stone <Class> [--base <Stone>] [--p7]
      Writes Stones/<Class>.{h,cxx} and adds the class to Stones/LinkDef.h.
      --p7 includes <Class>.h7, for accessors generated by project7.

  gled-create rnr <Glass> [--base <Glass>]
      Writes the GL renderer Rnr/GL/<Glass>_GL_Rnr.{h,cxx}, derived from
      <base>_GL_Rnr, and marks the glass in glass.list as having its own
      renderer. --base defaults to the base class of the glass.
FNORD
  exit 1;
}

usage() unless @ARGV;
my $what = shift @ARGV;

if    ($what eq 'libset') { create_libset(@ARGV); }
elsif ($what eq 'glass')  { create_glass(@ARGV);  }
elsif ($what eq 'stone')  { create_stone(@ARGV);  }
elsif ($what eq 'rnr')    { create_rnr(@ARGV);    }
else                      { usage(); }

########################################################################
# Helpers
########################################################################

sub slurp
{
  my $file = shift;
  open(my $fh, '<', $file) or die "can't open $file\n";
  local $/;
  my $s = <$fh>;
  close $fh;
  return $s;
}

sub spew
{
  my ($file, $s) = @_;
  open(my $fh, '>', $file) or die "can't write $file\n";
  print $fh $s;
  close $fh;
  print "wrote $file\n";
}

# Writes <outbase>.{h,cxx} from the template <skel>.{h,cxx}, replacing the
# @KEY@ placeholders with the values in %subst.
sub write_from_skel
{
  my ($skel, $outbase, %subst) = @_;
  for my $suf ('h', 'cxx')
  {
    die "$outbase.$suf exists\n" if -e "$outbase.$suf";
  }
  for my $suf ('h', 'cxx')
  {
    my $s = slurp("$SKELDIR/$skel.$suf");
    $s =~ s/\@(\w+)\@/exists $subst{$1} ? $subst{$1} : die "no value for \@$1\@ in $skel.$suf\n"/ge;
    spew("$outbase.$suf", $s);
  }
}

# Must be run in the top directory of a libset; returns its name.
sub libset_here
{
  die "glass.list and Makefile not found; run this in the top directory of a libset\n"
    unless -r "glass.list" and -r "Makefile";
  return basename(getcwd());
}

# Returns the lines of glass.list and a hash of its entries,
# class => [ class, id, stem, rnr ].
sub read_glass_list
{
  my @lines = split /^/m, slurp("glass.list");
  my %glasses;
  for (@lines)
  {
    next if /^\s*(#|$)/;
    my @f = split;
    $glasses{$f[0]} = [ @f ];
  }
  return (\@lines, \%glasses);
}

sub glass_list_line
{
  my ($c, $id, $stem, $rnr) = @_;
  return join("\t", $c, $id, $stem, (defined $rnr && $rnr ne '' ? ($rnr) : ())) . "\n";
}

# Glasses of all configured libsets, from build_config, plus those of the
# libset in the current directory.
sub known_glasses
{
  my %known;
  if (-r "$GLEDSYS/build_config")
  {
    our ($VAR1, $VAR2);
    do "$GLEDSYS/build_config" or die "error reading $GLEDSYS/build_config\n";
    %known = map { $_ => 1 } keys %{$VAR2->{GlassName2GlassSpecs}};
  }
  my (undef, $here) = read_glass_list();
  $known{$_} = 1 for keys %$here;
  return \%known;
}

sub makefile_dirs
{
  my $var = shift;
  my ($dirs) = slurp("Makefile") =~ m/^$var\s*:?=\s*(.*?)\s*$/m;
  return defined $dirs ? split(' ', $dirs) : ();
}

########################################################################
# libset
########################################################################

sub create_libset
{
  my @args = @_;
  my $requires = 'GledCore';
  GetOptionsFromArray(\@args, 'requires=s' => \$requires) or usage();
  my ($name, $id) = @args;
  usage() unless defined $id and $id =~ m/^\d+$/;
  die "libset name must start with a capital letter\n" unless $name =~ m/^[A-Z]\w*$/;

  my $dir = libsets_root() . "/$name";
  die "$dir exists\n" if -e $dir;

  if (-r "$GLEDSYS/build_config")
  {
    our ($VAR1, $VAR2);
    do "$GLEDSYS/build_config" or die "error reading $GLEDSYS/build_config\n";
    for my $ls (keys %{$VAR2->{LibName2LibSpecs}})
    {
      die "lib-set id $id is used by $ls\n" if $VAR2->{LibName2LibSpecs}{$ls}{LibID} == $id;
    }
  }

  mkdir $dir, 0755 or die "can't create $dir\n";
  # Glasses, Stones and <LibSet> hold the sources; the others are installed
  # into the symlink farms of $GLEDSYS.
  for my $d ("Glasses", "Stones", $name, "lib", "bin", "macros", "cfg", "libexec", "perllib")
  {
    mkdir "$dir/$d", 0755 or die "can't create $dir/$d\n";
  }

  spew("$dir/glass.list", <<"FNORD");
# glass		class	location		rnr-class
# name		id			[]~parent, [.]~own rnr, [<glass>]

FNORD

  spew("$dir/Makefile", <<"FNORD");
LIB_SET_NAME	  := $name
LIB_SET_ID	  := $id
REQUIRES_LIB_SETS := $requires

# Directory containing the glasses - full Gled enabled classes.
BLESSED_DIRS	:= Glasses
# Directories to be included in base library.
BASE_DIRS	:= Stones $name
# Directories for which dictionaries will be generated. A directory with
# classes other than glasses needs a LinkDef.h; see Stones/LinkDef.h.
DICT_DIRS	:= Glasses Stones $name

# Directories to go into the View / GUI library.
VIEW_DIRS	:=
# files from \${VIEW_FL_DIRS}/*.fl are processed by fluid
VIEW_FL_DIRS	:=

#--------------------------------------------------------------
include \${GLEDSYS}/make/make_base.inc
#--------------------------------------------------------------

# LIBSET_PREREQS +=
# LIBSET_TARGETS +=

# user targets go here; enumerate them in LIBSET_PREREQS/TARGETS

#--------------------------------------------------------------
include \${GLEDSYS}/make/make_targets.inc
#--------------------------------------------------------------

clean::
distclean::
FNORD

  print "created $dir\n";

  print <<"FNORD";

Next: add glasses and stones with 'gled-create glass|stone|rnr' in $dir,
then configure the new libset in \$GLEDSYS, listing all libsets to build:
  ./configure --reconfigure GledCore:...:$name
FNORD
}

########################################################################
# glass
########################################################################

sub create_glass
{
  my @args = @_;
  my ($base, $id) = ('ZGlass', undef);
  GetOptionsFromArray(\@args, 'base=s' => \$base, 'id=i' => \$id) or usage();
  my ($class) = @args;
  usage() unless defined $class;

  my $libset = libset_here();
  my ($lines, $glasses) = read_glass_list();
  die "$class is already in glass.list\n" if exists $glasses->{$class};
  die "unknown base glass $base\n" unless known_glasses()->{$base};

  my %ids = map { $_->[1] => $_->[0] } values %$glasses;
  if (defined $id)
  {
    die "class id $id is used by $ids{$id}\n" if exists $ids{$id};
  }
  else
  {
    $id = 1;
    for (keys %ids) { $id = $_ + 1 if $_ >= $id; }
  }

  write_from_skel("Glass_SKEL", "Glasses/$class",
                  LIBSET => $libset, CLASS => $class, BASE => $base);

  # No renderer column: the glass is rendered by the renderer of its base.
  open(my $fh, '>>', "glass.list") or die "can't append to glass.list\n";
  print $fh glass_list_line($class, $id, "Glasses/$class");
  close $fh;
  print "added $class with class id $id to glass.list\n";

  print <<"FNORD";

make picks up the new glass. Run './configure --reconfigure' in \$GLEDSYS
before a method of any glass takes $class as an argument: project7 looks up
glasses in build_config to stream such arguments.
FNORD
}

########################################################################
# stone
########################################################################

sub create_stone
{
  my @args = @_;
  my ($base, $p7);
  GetOptionsFromArray(\@args, 'base=s' => \$base, 'p7' => \$p7) or usage();
  my ($class) = @args;
  usage() unless defined $class;

  libset_here();
  my $libset = basename(getcwd());

  write_from_skel("Stone_SKEL", "Stones/$class",
                  LIBSET       => $libset,
                  CLASS        => $class,
                  BASE_INCLUDE => defined $base ? "#include <Stones/$base.h>" : "#include <Rtypes.h>",
                  BASE_CLAUSE  => defined $base ? " : public $base" : "",
                  P7_INCLUDE   => $p7 ? "#include \"$class.h7\"\n" : "");

  my $linkdef = "Stones/LinkDef.h";
  unless (-e $linkdef)
  {
    spew($linkdef, <<"FNORD");
// Selection rules for the ${libset}_Stones dictionary.
//
// gled_mk_dict_gen.pl copies this file into dict/${libset}_Stones_LinkDef.h.
//
// Linking of nested classes and nested typedefs is enabled for all classes.

FNORD
  }
  open(my $fh, '>>', $linkdef) or die "can't append to $linkdef\n";
  print $fh "#pragma link C++ class gled::$class+;\n";
  close $fh;
  print "added $class to $linkdef\n";

  for my $var ('BASE_DIRS', 'DICT_DIRS')
  {
    print "warning: Stones is not in $var in the Makefile\n"
      unless grep { $_ eq 'Stones' } makefile_dirs($var);
  }
}

########################################################################
# rnr
########################################################################

sub libsets_root
{
  # The first directory of the build's libsetpath, as recorded in
  # build_config; ../libsets without it. Relative to GLEDSYS.
  my $path = '../libsets';
  if (-r "$GLEDSYS/build_config")
  {
    our ($VAR1, $VAR2);
    do "$GLEDSYS/build_config" or die "error reading $GLEDSYS/build_config\n";
    $path = $VAR1->{LIBSET_PATH} if defined $VAR1->{LIBSET_PATH} and $VAR1->{LIBSET_PATH} ne '';
  }
  my ($first) = split(/\s*:\s*/, $path);
  return $first =~ m!^/! ? $first : "$GLEDSYS/$first";
}

sub libset_dirs
{
  # Directories of the configured libsets, from build_config; without it, the
  # libsets in the first libsetpath directory.
  if (-r "$GLEDSYS/build_config")
  {
    our ($VAR1, $VAR2);
    do "$GLEDSYS/build_config" or die "error reading $GLEDSYS/build_config\n";
    my @dirs = grep { defined } map { $_->{Dir} } values %{$VAR2->{LibName2LibSpecs}};
    return @dirs if @dirs;
  }
  return glob(libsets_root() . "/*");
}

sub create_rnr
{
  my @args = @_;
  my $base;
  GetOptionsFromArray(\@args, 'base=s' => \$base) or usage();
  my ($class) = @args;
  usage() unless defined $class;

  my $libset = libset_here();
  my ($lines, $glasses) = read_glass_list();
  die "$class is not in glass.list\n" unless exists $glasses->{$class};
  my $stem = $glasses->{$class}[2];

  unless (defined $base)
  {
    ($base) = slurp("$stem.h") =~ m/^\s*class\s+$class\s*:\s*public\s+(\w+)/m
      or die "can't find the base class of $class in $stem.h; use --base\n";
  }
  my @base_hdr = grep { -r } ("Rnr/GL/${base}_GL_Rnr.h",
                              map { "$_/Rnr/GL/${base}_GL_Rnr.h" } libset_dirs());
  die "no renderer ${base}_GL_Rnr found; use --base with a glass that has its own renderer\n"
    unless @base_hdr;

  system("mkdir -p Rnr/GL") == 0 or die "can't create Rnr/GL\n";
  write_from_skel("Rnr_GL_SKEL", "Rnr/GL/${class}_GL_Rnr",
                  LIBSET => $libset, CLASS => $class, BASE => $base);

  # Mark the glass as having its own renderer.
  for (@$lines)
  {
    next if /^\s*(#|$)/;
    my @f = split;
    $_ = glass_list_line(@f[0..2], '.') if $f[0] eq $class;
  }
  spew("glass.list", join('', @$lines));
  print "marked $class in glass.list as having its own renderer\n";
}
